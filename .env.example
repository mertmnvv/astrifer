# Firebase (Admin SDK service account — see README for setup)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Cloudinary (free-tier photo/voice-note storage — see README for setup)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Geocoding (place search/autocomplete in /create)
GEOCODING_API_KEY=

# 300 DPI print render (Puppeteer, runs in-process via a Next.js server
# action — see lib/printRender.ts. Not needed in production: @sparticuz/chromium
# supplies its own serverless-compatible Chromium binary there. Only needed
# for local dev, pointed at a local Chrome/Chromium executable.)
PUPPETEER_EXECUTABLE_PATH=

# Admin panel (/admin) — single shared password, no per-user accounts
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Dijital Sayfa owner edit-link token — proves "page owner" without accounts
# (see lib/starmapOwnerToken.ts). Separate from ADMIN_SESSION_SECRET so
# rotating the admin password never invalidates customers' own pages.
STARMAP_OWNER_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
